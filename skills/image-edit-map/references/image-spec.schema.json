{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image Edit Map visual specification",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "mode": {
      "enum": [
        "map",
        "reverse_engineer"
      ]
    },
    "coverage": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "complete_visible_inventory",
            "partial"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "notes"
      ],
      "additionalProperties": false
    },
    "coordinate_system": {
      "const": "normalized_original_image_top_left_xywh"
    },
    "images": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/image"
      },
      "minItems": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "picture_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "composition": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "text_content": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "typography": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "palette": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "color_grading": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "lighting": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "preservation": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "export": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "reconstruction": {
      "$ref": "#/$defs/reconstruction"
    }
  },
  "required": [
    "schema_version",
    "mode",
    "coverage",
    "coordinate_system",
    "images",
    "sections",
    "elements",
    "relationships",
    "picture_types",
    "composition",
    "text_content",
    "typography",
    "palette",
    "color_grading",
    "lighting",
    "materials",
    "layers",
    "preservation",
    "export",
    "unknowns",
    "reconstruction"
  ],
  "additionalProperties": false,
  "$defs": {
    "observation": {
      "type": "object",
      "properties": {
        "value": {},
        "basis": {
          "enum": [
            "source_metadata",
            "pixel_measurement",
            "visual_observation",
            "visual_estimate",
            "user_supplied",
            "unknown"
          ]
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "value",
        "basis",
        "confidence",
        "note"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "basis": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "confidence": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "basis": {
                "const": "unknown"
              },
              "confidence": {
                "const": "unknown"
              }
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "properties": {
        "target_id": {
          "type": "string"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/observation"
          },
          "minProperties": 1
        }
      },
      "required": [
        "target_id",
        "attributes"
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "role": {
          "enum": [
            "target",
            "reference",
            "analysis"
          ]
        },
        "reference_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "version": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/observation"
          },
          "minProperties": 1
        }
      },
      "required": [
        "id",
        "source",
        "role",
        "reference_roles",
        "version",
        "metadata"
      ],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "image_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "geometry_basis": {
          "enum": [
            "pixel_measurement",
            "visual_estimate",
            "user_supplied"
          ]
        }
      },
      "required": [
        "id",
        "image_id",
        "name",
        "bbox",
        "geometry_basis"
      ],
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "image_id": {
          "type": "string"
        },
        "section_id": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        },
        "anchor": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "geometry_basis": {
          "enum": [
            "pixel_measurement",
            "visual_estimate",
            "user_supplied"
          ]
        },
        "editable_properties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "locked_properties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/observation"
          },
          "minProperties": 1
        }
      },
      "required": [
        "id",
        "image_id",
        "section_id",
        "number",
        "name",
        "kind",
        "bbox",
        "anchor",
        "geometry_basis",
        "editable_properties",
        "locked_properties",
        "attributes"
      ],
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "image_id": {
          "type": "string"
        },
        "from_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "to_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "enum": [
            "connector",
            "contains",
            "overlaps",
            "in_front_of",
            "grouped_with",
            "other"
          ]
        },
        "direction": {
          "enum": [
            "from_to",
            "to_from",
            "bidirectional",
            "none",
            "unknown"
          ]
        },
        "label": {
          "$ref": "#/$defs/observation"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "image_id",
        "from_id",
        "to_id",
        "kind",
        "direction",
        "label",
        "confidence",
        "note"
      ],
      "additionalProperties": false
    },
    "unknown": {
      "type": "object",
      "properties": {
        "target_id": {
          "type": "string"
        },
        "property": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "question": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "target_id",
        "property",
        "reason",
        "question"
      ],
      "additionalProperties": false
    },
    "reconstruction": {
      "type": "object",
      "properties": {
        "is_original_prompt": {
          "const": false
        },
        "brief": {
          "type": "string"
        },
        "preserve": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unverified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "is_original_prompt",
        "brief",
        "preserve",
        "unverified"
      ],
      "additionalProperties": false
    }
  }
}
